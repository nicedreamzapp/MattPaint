{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MattPaint",
  "version": "1.0.0",
  "identifier": "com.nicedreamz.mattpaint",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "node copy-web.mjs",
    "beforeDevCommand": "node copy-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Microsoft Paint, for Mac and Windows",
    "copyright": "Matt Macosko",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
